generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model User {
  id                String @id  @default(cuid())
  name              String 
  password          String
  email             String
  role              ROLE
  supervisorId      String?
}


model Conversation {
  id                String    @id @default(cuid())
  candidateId       String    
  agentId           String
  supervisorId      String
  status            STATUS
  createdAt         DateTime   @default(now())
}


enum ROLE {
  admin
  supervisor
  agent
  candidate
}

enum STATUS {
  open
  assigned
  closed
}